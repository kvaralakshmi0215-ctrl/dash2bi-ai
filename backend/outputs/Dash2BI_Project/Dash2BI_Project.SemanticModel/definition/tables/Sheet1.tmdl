table 'Sheet1'

	column 'Sno'
		dataType: double
		sourceColumn: 'Sno'

	column 'Date'
		dataType: dateTime
		sourceColumn: 'Date'

	column 'State/UnionTerritory'
		dataType: string
		sourceColumn: 'State/UnionTerritory'

	column 'ConfirmedIndianNational'
		dataType: double
		sourceColumn: 'ConfirmedIndianNational'

	column 'ConfirmedForeignNational'
		dataType: double
		sourceColumn: 'ConfirmedForeignNational'

	column 'Cured'
		dataType: double
		sourceColumn: 'Cured'

	column 'Deaths'
		dataType: double
		sourceColumn: 'Deaths'

	partition 'Sheet1' = m
		mode: import
		source =
			let
				Source = Excel.CurrentWorkbook(){[Name="Sheet1"]}[Content]
			in
				Source

	measure 'TOTAL CONFIRMED' = SUM('Sheet1'[ConfirmedForeignNational])

	measure 'CURED' = SUM('Sheet1'[Cured])

	measure 'DEATHS' = SUM('Sheet1'[Deaths])
